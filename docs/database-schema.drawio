        <!-- TABLE 9: SCHEMA_MIGRATIONS (AUDIT DEPLOIEMENT HORS EF) -->
        <mxCell id="table_schema_migrations" value="&lt;b&gt;schema_migrations&lt;/b&gt; (Table Système d'Audit SQL)&lt;hr&gt;&lt;table style=&quot;width:100%;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;version (ex: V001)&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;description&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;script_name (V001__initial_schema.sql)&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;checksum (SHA256)&lt;/td&gt;&lt;td&gt;VARCHAR(64)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;applied_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;execution_time_ms&lt;/td&gt;&lt;td&gt;INTEGER&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;applied_by&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontColor=#1F2937;fontFamily=Rubik;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="310" height="190" as="geometry" />
        </mxCell>

        <!-- ENCART EXPLICATIF : INDIRECTION TRANSPARENTE -->
        <mxCell id="box_explanation" value="&lt;b&gt;FONCTIONNEMENT DE L'INDIRECTION TRANSPARENTE :&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Étiquette Physique Stable :&lt;/b&gt; Lors de la réception, une étiquette avec &lt;code&gt;tracking_code&lt;/code&gt; immuable (ex: MT-8F92A1) est collée sur le sac ou baril.&lt;br&gt;2. &lt;b&gt;Liaison Dynamique :&lt;/b&gt; Une entrée est créée dans &lt;code&gt;transport_assignments&lt;/code&gt; avec &lt;code&gt;is_active = TRUE&lt;/code&gt; pointant vers le &lt;code&gt;trip_id&lt;/code&gt; du Camion 1.&lt;br&gt;3. &lt;b&gt;Transvasement sans réétiquetage :&lt;/b&gt; Si le convoyeur transvase le colis dans le Conteneur 2, l'ancienne liaison passe à &lt;code&gt;is_active = FALSE&lt;/code&gt; et une nouvelle ligne est insérée pointant vers le nouveau &lt;code&gt;trip_id&lt;/code&gt;.&lt;br&gt;4. &lt;b&gt;Impact Client :&lt;/b&gt; Le client continue à suivre son colis avec le même QR code / tracking_code, sans interruption et sans confusion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;align=left;spacingLeft=15;fontColor=#1E40AF;fontSize=12;fontFamily=Rubik;" vertex="1" parent="1">
          <mxGeometry x="1210" y="730" width="460" height="220" as="geometry" />
        </mxCell>

        <!-- RELATIONS / LIAISONS ERD -->
        <!-- users -> carriers -->
        <mxCell id="rel_users_carriers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeColor=#273349;strokeWidth=1.5;" edge="1" source="table_users" target="table_carriers" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- carriers -> catalog -->
        <mxCell id="rel_carriers_catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeColor=#273349;strokeWidth=1.5;" edge="1" source="table_carriers" target="table_catalog" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- carriers -> trips -->
        <mxCell id="rel_carriers_trips" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;strokeColor=#273349;strokeWidth=1.5;" edge="1" source="table_carriers" target="table_trips" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="575" y="420" />
              <mxPoint x="1375" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- catalog -> parcels -->
        <mxCell id="rel_catalog_parcels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#273349;strokeWidth=1.5;" edge="1" source="table_catalog" target="table_parcels" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- parcels -> transport_assignments (indirection) -->
        <mxCell id="rel_parcels_assignments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;strokeColor=#DC2626;strokeWidth=2.5;" edge="1" source="table_parcels" target="table_assignments" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- trips -> transport_assignments -->
        <mxCell id="rel_trips_assignments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#DC2626;strokeWidth=2.5;" edge="1" source="table_trips" target="table_assignments" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- parcels -> milestones -->
        <mxCell id="rel_parcels_milestones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#273349;strokeWidth=1.5;" edge="1" source="table_parcels" target="table_milestones" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- parcels -> communications -->
        <mxCell id="rel_parcels_comms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;strokeColor=#273349;strokeWidth=1.5;" edge="1" source="table_parcels" target="table_comms" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="640" />
              <mxPoint x="760" y="955" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
